{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": ["^/game_sessions/\\d+$"],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": ["/new$"],
      "properties": {
        "context": "modal",
        "modal_style": "full",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": ["^$", "^/$"],
      "properties": {
        "presentation": "clear_all"
      }
    }
  ]
}
