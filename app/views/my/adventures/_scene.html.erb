<%# locals: (scene:, party:) -%>
<% roll = scene.chosen_choice&.roll %>
<section class="adventure__scene">
  <header>
    <p class="adventure__place"><%= [ scene.counter, scene.location ].compact_blank.join(" · ") %></p>
    <h2><%= scene.heading %></h2>
  </header>

  <% unless scene.finale? && roll.nil? %>
    <div class="narration__body">
      <%= render "scenes/narration", scene: scene %>
    </div>
  <% end %>

  <% if roll && !scene.finale? %>
    <%= render "rolls/move", roll: roll, party: party %>

    <div class="narration__body">
      <%= simple_format h(roll.resolution) %>
    </div>
  <% end %>
</section>
