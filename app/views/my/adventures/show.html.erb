<% content_for :title, @adventure.title %>
<% content_for :screen, "screen--medium" %>

<%= render "back", to: my_adventures_path, title: @adventure.title %>

<article class="adventure">
  <p class="adventure__summary"><%= adventure_summary(@adventure) %></p>

  <%= render partial: "my/adventures/scene", collection: @scenes, locals: { party: (@adventure.party.to_a if @adventure.multiplayer?) } %>

  <%= render "game_sessions/ending", game_session: @adventure, titled: false %>
</article>
