<%# locals: (record:) -%>
<section class="record">
  <h2 class="field-label"><%= t(".title") %></h2>

  <dl class="record__figures">
    <div class="record__figure record__figure--shelf">
      <dt><%= link_to t(".adventures", count: record.adventures), my_adventures_path, class: "record__link" %></dt>
      <dd><%= record.adventures %></dd>
    </div>
    <div class="record__figure">
      <dt><%= t(".victories", count: record.victories) %></dt>
      <dd><%= record.victories %></dd>
    </div>
    <div class="record__figure">
      <dt><%= t(".defeats", count: record.defeats) %></dt>
      <dd><%= record.defeats %></dd>
    </div>
    <div class="record__figure">
      <dt><%= t(".dice_rolled") %></dt>
      <dd><%= record.dice_rolled %></dd>
    </div>
    <div class="record__figure">
      <dt><%= t(".party_adventures") %></dt>
      <dd><%= record.party_adventures %></dd>
    </div>
    <% if (klass = record.favorite_klass) %>
      <div class="record__figure record__figure--word">
        <dt><%= t(".favorite_klass") %></dt>
        <dd><%= klass.label %></dd>
      </div>
    <% end %>
  </dl>
</section>
