<% content_for :title, "#{t(".title")} · Rokapi" %>
<% content_for :screen, "screen--medium" %>

<div class="account">
  <%= render "back", to: root_path, title: t(".title") %>

  <div class="identity">
    <%= avatar_tag Current.user, "avatar--ringed", hidden: true %>
    <div>
      <strong class="identity__name"><%= Current.user.name %></strong>
      <span class="identity__email"><%= Current.user.email %></span>
    </div>
  </div>

  <% if (record = Current.user.record).any? %>
    <%= render "record", record: record %>

    <% if (badges = Current.user.badges).any? %>
      <%= render "badges", badges: badges %>
    <% end %>
  <% end %>

  <%= render "menu_row", to: subscription_path, icon: "flame", title: t(".subscription"),
        text: t(".subscription_text"), classes: "menu-row--featured account__subscription-link" %>

  <% unless hotwire_native_app? %>
    <section class="account__subscription">
      <h2 class="field-label"><%= t(".subscription") %></h2>
      <%= turbo_frame_tag :subscription, src: subscription_path, loading: :lazy, refresh: :morph, target: "_top" %>
    </section>
  <% end %>

  <%= render "menu_row", to: my_adventures_path, icon: "book", title: t(".adventures"), text: t(".adventures_text") %>

  <%= render "menu_row", to: my_places_path, icon: "map", title: t(".places"), text: t(".places_text") %>

  <%= render "menu_row", to: my_settings_path, icon: "sliders", title: t(".settings"), text: t(".settings_text") %>

  <section>
    <h2 class="field-label"><%= t(".language") %></h2>
    <div class="segmented">
      <%= render "locales", option_class: "segment" %>
    </div>
  </section>

  <%= button_to t(".sign_out"), session_path, method: :delete, class: "btn btn--secondary btn--inline", form_class: "account__sign-out" %>
</div>
