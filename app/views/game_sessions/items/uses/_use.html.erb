<%# locals: (game_session:, item:, restored:) -%>
<% character = item.character %>
<div class="outcome outcome--restored">
  <span class="outcome__badge"><%= render "glyph", name: "flask" %></span>

  <p class="outcome__verdict"><%= t(".health_change", change: format("%+d", restored)) %></p>

  <div class="outcome__vitals">
    <div class="vitals__row">
      <span class="vitals__label overline"><%= render "glyph", name: "heart" %> <%= t(".health") %></span>
      <span class="vitals__count">
        <%= character.hp - restored %> <span>→</span> <%= character.hp %> <span>/ <%= character.max_hp %></span>
      </span>
    </div>
    <div class="vitals__track">
      <div class="vitals__fill vitals__fill--restored" style="inline-size: <%= character.hp_percentage %>%"></div>
      <div class="vitals__mark" style="inset-inline-start: <%= character.hp_percentage(character.hp - restored) %>%"></div>
    </div>
  </div>

  <p class="outcome__resolution"><%= t(".takes_effect", item: item.name) %></p>
</div>

<div class="stage__footer">
  <%= link_to t(".done"), game_session_path(game_session), class: "btn btn--primary" %>
</div>
