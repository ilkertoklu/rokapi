<% content_for :title, "#{t(".title")} · Rokapi" %>
<% content_for :screen, "screen--wide" %>

<%= form_with model: @character, url: game_session_character_path(@game_session), class: "flow flow--columns",
      data: { controller: "stats", stats_free_value: Character::FREE_POINTS, stats_cap_value: Character::STAT_CAP,
              stats_klass_value: @character.klass, stats_bases_value: Character::Klass.base_stats_by_key.to_json,
              stats_ready_value: t(".ready"), stats_points_left_value: t(".points_left").to_json,
              stats_raised_class: "stat-row__value--raised" } do |form| %>

  <%= render "back", to: new_game_sessions_solo_path, title: t(".title") %>

  <%= render "choice_fieldset", form: form, legend: t(".race"), attribute: :race,
        options: Character::Race.all, selected: @character.race %>

  <%= render "choice_fieldset", form: form, legend: t(".klass"), attribute: :klass,
        options: Character::Klass.all, selected: @character.klass, rebase: true %>

  <%= render "choice_fieldset", form: form, legend: t(".background"), attribute: :background,
        options: Character::Background.all, selected: @character.background %>

  <fieldset class="choices flow__aside">
    <legend><%= t(".abilities") %> <span class="points-left" data-stats-target="remaining"></span></legend>

    <%= form.fields_for :stats do |stats| %>
      <% Character::Stat.all.each do |stat| %>
        <div class="stat-row">
          <span class="stat-row__label"><%= stat.label %></span>
          <%= tag.button "−", type: "button", class: "stepper", aria: { label: t(".lower", stat: stat.label) },
                data: { stats_target: "decrement", action: "stats#decrement", stats_key_param: stat.key } %>
          <%= stats.number_field stat.key, value: @character.stats[stat.key], readonly: true, data: { stats_target: "value", key: stat.key } %>
          <%= tag.button "+", type: "button", class: "stepper stepper--up", aria: { label: t(".raise", stat: stat.label) },
                data: { stats_target: "increment", action: "stats#increment", stats_key_param: stat.key } %>
        </div>
      <% end %>
    <% end %>
  </fieldset>

  <div class="sticky-footer">
    <%= form.button class: "btn btn--primary btn--inline", aria: { keyshortcuts: "Enter" },
          data: { stats_target: "submit", controller: "hotkey", action: "keydown.enter@document->hotkey#click" } do %>
      <span data-stats-target="label"><%= t(".ready") %></span> <kbd class="key" aria-hidden="true">↵</kbd>
    <% end %>
  </div>
<% end %>
