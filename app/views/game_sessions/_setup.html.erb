<%# locals: (url:, back:, title:, submit:, estimates:, cards:) -%>
<%= form_with url: url, scope: :game_session, class: "flow" do |form| %>
  <%= render "back", to: back, title: title %>

  <fieldset class="choices" aria-label="<%= t(".quest") %>">
    <% cards.each do |card| %>
      <label class="pick">
        <%= form.radio_button :card, card.key, checked: card == cards.first %>
        <span class="pick__body">
          <span class="pick__title"><%= card.place.text %></span>
          <span class="pick__text"><%= card.trouble.text %></span>
          <span class="pick__text"><%= card.figure.text %></span>
        </span>
        <span class="pick__mark"></span>
      </label>
    <% end %>

    <%= link_to t(".draw_again"), request.path, class: "redraw", data: { turbo_action: "replace" } %>

    <label class="pick">
      <%= form.radio_button :card, "", checked: false %>
      <span class="pick__body">
        <span class="pick__title"><%= t(".surprise") %></span>
        <span class="pick__text"><%= t(".surprise_text") %></span>
      </span>
      <span class="pick__mark"></span>
    </label>
  </fieldset>

  <fieldset class="choices">
    <legend><%= t(".tone") %></legend>
    <div class="segmented">
      <% GameSession::Tone.all.each do |tone| %>
        <label class="segment">
          <%= form.radio_button :tone, tone.key, checked: tone.key == "balanced" %>
          <span><%= tone.label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="choices">
    <legend><%= t(".length") %></legend>
    <div class="segmented">
      <% GameSession::Length.all.each do |length| %>
        <label class="segment">
          <%= form.radio_button :length, length.key, checked: length.key == "medium" %>
          <span><%= length.label %><small><%= estimates.fetch(length.key) %></small></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="sticky-footer">
    <%= form.submit submit, class: "btn btn--primary" %>
  </div>
<% end %>
