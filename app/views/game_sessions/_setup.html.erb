<%# locals: (url:, back:, title:, submit:, cards:) -%>
<%= form_with url: url, scope: :game_session, class: "flow" do |form| %>
  <%= render "back", to: back, title: title %>

  <fieldset class="choices" data-controller="hand">
    <legend>
      <%= t(".quest") %>
      <%= link_to request.path, class: "redraw", title: t(".draw_again"), aria: { label: t(".draw_again") }, data: { turbo_action: "replace" } do %>
        <%= render "glyph", name: "shuffle" %>
      <% end %>
    </legend>

    <div class="hand" data-hand-target="deck">
      <% cards.each do |card| %>
        <label class="fate-card" data-hand-target="card">
          <%= form.radio_button :card, card.key, checked: card == cards.first, data: { action: "hand#bring" } %>
          <span class="fate-card__place"><%= card.place.text %></span>
          <span class="fate-card__trouble"><%= card.trouble.text %></span>
          <span class="fate-card__figure"><%= card.figure.text %></span>
        </label>
      <% end %>

      <label class="fate-card fate-card--face-down" data-hand-target="card">
        <%= form.radio_button :card, "", checked: false, data: { action: "hand#bring" } %>
        <span class="fate-card__place"><%= t(".surprise") %></span>
        <span class="fate-card__trouble"><%= t(".surprise_text") %></span>
      </label>
    </div>

    <div class="hand__dots" aria-hidden="true">
      <% cards.each do %>
        <span class="hand__dot" data-hand-target="dot"></span>
      <% end %>
      <span class="hand__dot hand__dot--face-down" data-hand-target="dot"></span>
    </div>
  </fieldset>

  <fieldset class="choices">
    <legend><%= t(".tone") %></legend>
    <div class="segmented">
      <% GameSession::Tone.all.each do |tone| %>
        <label class="segment">
          <%= form.radio_button :tone, tone.key, checked: tone.key == "balanced" %>
          <span><%= tone.label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="choices">
    <legend><%= t(".length") %></legend>
    <div class="segmented">
      <% GameSession::Length.all.each do |length| %>
        <label class="segment">
          <%= form.radio_button :length, length.key, checked: length.key == "medium" %>
          <span><%= length.label %><small><%= length.estimate %></small></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="sticky-footer">
    <%= form.submit submit, class: "btn btn--primary" %>
  </div>
<% end %>
