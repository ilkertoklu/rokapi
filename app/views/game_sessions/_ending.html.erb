<%# locals: (game_session:, titled: true) -%>
<% finale = game_session.current_scene %>
<% roll = finale.roll %>
<% party = game_session.party.to_a if game_session.multiplayer? %>

<div class="finale">
  <div class="finale__crest">
    <span class="ember ember--large" aria-hidden="true"></span>
    <p class="finale__outcome overline"><%= t(game_session.outcome, scope: "game_session.outcomes") %></p>
    <% if titled %>
      <h1><%= finale.title %></h1>
    <% end %>
  </div>

  <% if roll %>
    <%= render "rolls/move", roll: roll, party: party %>
  <% end %>

  <div class="finale__closing">
    <%= simple_format h(finale.closing) %>
  </div>

  <hr>

  <dl class="highlights">
    <div>
      <dt><%= t(".duration") %></dt>
      <dd><%= duration_label(game_session.duration) %></dd>
    </div>
    <div>
      <dt><%= t(".dice_rolled") %></dt>
      <dd><%= game_session.dice_rolled %></dd>
    </div>
    <% if game_session.multiplayer? %>
      <div>
        <dt><%= t(".alive") %></dt>
        <dd><%= party.reject(&:fallen?).size %></dd>
      </div>
    <% end %>
  </dl>

  <% if game_session.multiplayer? %>
    <ul class="roster">
      <% party.each_with_index do |player, seat| %>
        <%= tag.li class: [ "roster__member", "roster__member--fallen": player.fallen? ] do %>
          <%= player_avatar player, seat: seat, hidden: true %>
          <span><%= player.name %></span>
        <% end %>
      <% end %>
    </ul>
  <% end %>
</div>
