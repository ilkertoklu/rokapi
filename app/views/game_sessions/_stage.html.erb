<%# locals: (game_session:) -%>
<div id="game_stage" class="stage">
  <% scene = game_session.current_scene %>
  <% roll = scene.roll %>
  <% if scene.rolling? || roll&.pending? %>
    <%= render "rolls/dice", choice: scene.chosen_choice, roll: roll, game_session: game_session %>
  <% elsif roll&.unseen? %>
    <%= render "rolls/outcome", roll: roll, game_session: game_session %>
  <% elsif game_session.finished? %>
    <%= render "game_sessions/finale", game_session: game_session %>
  <% elsif scene.opening? %>
    <%= render "game_sessions/opening", scene: scene %>
  <% else %>
    <%= render "scenes/scene", scene: scene %>
  <% end %>
</div>
