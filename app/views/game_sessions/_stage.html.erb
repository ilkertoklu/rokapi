<%# locals: (game_session:, player:) -%>
<% scene = game_session.current_scene %>
<%= tag.div id: "game_stage", class: "stage", tabindex: -1, data: { controller: "stage", stage_step_value: dom_id(scene) } do %>
  <% roll = scene.roll %>
  <% if scene.finale? %>
    <%= render "game_sessions/finale", game_session: game_session %>
  <% elsif scene.opening? %>
    <%= render "game_sessions/opening", scene: scene %>
  <% elsif !scene.turn_of?(player) %>
    <%= render "scenes/scene", scene: scene, viewer: player %>
  <% elsif scene.rolling? || roll&.pending? %>
    <%= render "rolls/dice", choice: scene.chosen_choice, roll: roll, character: player.character, game_session: game_session %>
  <% elsif roll&.unseen? %>
    <%= render "rolls/outcome", roll: roll, game_session: game_session %>
  <% else %>
    <%= render "scenes/scene", scene: scene, viewer: player %>
  <% end %>
<% end %>
