<%# locals: (scene:, text:) -%>
<div class="stage__footer">
  <% if scene.stalled? %>
    <%= render "game_sessions/stalled", game_session: scene.game_session,
          hint: "The narrator stalled. You can pick the story up where it left off." %>
  <% else %>
    <%= render "game_sessions/writing", text: text %>
    <div class="overdue">
      <%= render "game_sessions/stalled", game_session: scene.game_session,
            hint: "The narrator is taking a while. You can pick the story up where it left off." %>
    </div>
  <% end %>
</div>
