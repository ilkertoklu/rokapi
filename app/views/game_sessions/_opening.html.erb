<%# locals: (scene:) -%>
<% game_session = scene.game_session %>
<% length = GameSession::Length.fetch(game_session.length) %>
<header class="location">
  <div class="location__place">
    <span class="location__pin"><%= render "glyph", name: "pin" %></span>
    <div>
      <h1><%= game_session.title %></h1>
      <p><%= GameSession::Tone.fetch(game_session.tone).label %> · <%= length.label %> · <%= length.estimate %></p>
    </div>
  </div>
</header>

<div class="narration">
  <p class="scene__speaker overline"><span class="ember <%= "ember--pulsing" if scene.narrator_writing? %>"></span> Anlatıcı</p>
</div>

<%= render "game_sessions/waiting", scene: scene, text: "Anlatıcı hazırlanıyor" %>
