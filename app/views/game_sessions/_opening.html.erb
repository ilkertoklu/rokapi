<%# locals: (scene:) -%>
<% game_session = scene.game_session %>
<header class="location">
  <div class="location__place">
    <h1><%= game_session.title %></h1>
    <p><%= game_session.tone_label %> · <%= game_session.length_label %> · <%= game_session.length_estimate %></p>
  </div>
</header>

<div class="narration">
  <p class="scene__speaker"><span class="ember <%= "ember--pulsing" if scene.narrator_writing? %>"></span> <%= t(".narrator") %></p>
  <%= tag.div id: "scene_narration", class: [ "narration__body", "narration__body--writing": scene.narrator_writing? ] do %>
    <%= render "scenes/narration", scene: scene %>
  <% end %>
</div>

<%= render "game_sessions/waiting", scene: scene, text: t(".getting_ready") %>
