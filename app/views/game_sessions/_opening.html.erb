<%# locals: (game_session:) -%>
<header class="location">
  <div class="location__place">
    <span class="location__pin"><%= render "glyph", name: "pin" %></span>
    <div>
      <h1><%= game_session.title %></h1>
      <p><%= GameSession::TONES.fetch(game_session.tone) %> · <%= GameSession::LENGTHS.fetch(game_session.length) %> · <%= solo_duration(game_session.length) %></p>
    </div>
  </div>
</header>

<div class="narration">
  <p class="scene__speaker overline"><span class="ember ember--pulsing"></span> Anlatıcı</p>
</div>

<div class="stage__footer">
  <p class="writing">
    Anlatıcı hazırlanıyor
    <span class="writing__dots"><span></span><span></span><span></span></span>
  </p>
</div>
