<% content_for :title, "#{@game_session.title} · Rokapi" %>
<% turbo_exempts_page_from_cache %>

<div data-controller="connection">
  <%= turbo_stream_from @game_session, id: dom_id(@game_session, :stream), data: { turbo_permanent: true, connection_target: "source" } %>
  <%= render "game_sessions/connection" %>
</div>

<% if @game_session.lobby? %>
  <% content_for :screen, "screen--wide" %>
  <%= render "game_sessions/lobby", game_session: @game_session, player: @player %>
<% else %>
  <div class="game" data-controller="sheet" data-sheet-stage-outlet="#game_stage">
    <%= render "game_sessions/stage", game_session: @game_session, player: @player %>

    <%= render "characters/sheet", character: @character %>
  </div>
<% end %>
