<% content_for :title, "New adventure · Rokapi" %>

<%= form_with url: game_sessions_solo_path, scope: :game_session, class: "flow" do |form| %>
  <%= render "back", to: new_game_session_path, title: "New adventure" %>

  <fieldset class="choices">
    <legend>Quest</legend>

    <% GameSession::Quest.all.each do |quest| %>
      <label class="pick">
        <%= form.radio_button :quest, quest.key, checked: quest == GameSession::Quest.all.first %>
        <span class="pick__icon"><%= render "glyph", name: "bell" %></span>
        <span class="pick__body">
          <span class="pick__title"><%= quest.title %></span>
          <span class="pick__text"><%= quest.hook %></span>
        </span>
        <span class="pick__mark"></span>
      </label>
    <% end %>

    <label class="pick">
      <%= form.radio_button :quest, "", checked: false %>
      <span class="pick__icon"><%= render "glyph", name: "compass" %></span>
      <span class="pick__body">
        <span class="pick__title">Surprise</span>
        <span class="pick__text">Let the narrator build an unknown world.</span>
      </span>
      <span class="pick__mark"></span>
    </label>
  </fieldset>

  <fieldset class="choices">
    <legend>Tone</legend>
    <div class="segmented">
      <% GameSession::Tone.all.each do |tone| %>
        <label class="segment">
          <%= form.radio_button :tone, tone.key, checked: tone.key == "balanced" %>
          <span><%= tone.label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="choices">
    <legend>Length</legend>
    <div class="segmented">
      <% GameSession::Length.all.each do |length| %>
        <label class="segment">
          <%= form.radio_button :length, length.key, checked: length.key == "medium" %>
          <span><%= length.label %><small><%= length.estimate %></small></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="sticky-footer">
    <%= form.submit "Create your character", class: "btn btn--primary" %>
  </div>
<% end %>
