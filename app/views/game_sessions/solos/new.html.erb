<% content_for :title, "Yeni macera · Rokapi" %>

<%= form_with url: game_sessions_solo_path, scope: :game_session, class: "flow" do |form| %>
  <%= render "back", to: new_game_session_path, title: "Yeni macera" %>

  <fieldset class="choices">
    <legend>Görev</legend>

    <% @adventures.each do |adventure| %>
      <label class="pick">
        <%= form.radio_button :adventure_id, adventure.id, checked: adventure == @adventures.first %>
        <span class="pick__icon"><%= render "glyph", name: "bell" %></span>
        <span class="pick__body">
          <span class="pick__title"><%= adventure.title %></span>
          <span class="pick__text"><%= adventure.hook %></span>
        </span>
        <span class="pick__mark"></span>
      </label>
    <% end %>

    <label class="pick">
      <%= form.radio_button :adventure_id, "", checked: false %>
      <span class="pick__icon"><%= render "glyph", name: "compass" %></span>
      <span class="pick__body">
        <span class="pick__title">Sürpriz</span>
        <span class="pick__text">Anlatıcı bilinmeyen bir dünya kursun.</span>
      </span>
      <span class="pick__mark"></span>
    </label>
  </fieldset>

  <fieldset class="choices">
    <legend>Ton</legend>
    <div class="segmented">
      <% GameSession::Tone.all.each do |tone| %>
        <label class="segment">
          <%= form.radio_button :tone, tone.key, checked: tone.key == "balanced" %>
          <span><%= tone.label %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="choices">
    <legend>Uzunluk</legend>
    <div class="segmented">
      <% GameSession::Length.all.each do |length| %>
        <label class="segment">
          <%= form.radio_button :length, length.key, checked: length.key == "medium" %>
          <span><%= length.label %><small><%= length.estimate %></small></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="sticky-footer">
    <%= form.submit "Karakterini oluştur", class: "btn btn--primary" %>
  </div>
<% end %>
