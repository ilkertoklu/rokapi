<%# locals: (game_session:) -%>
<% finale = game_session.current_scene %>

<div class="finale">
  <div class="finale__crest">
    <span class="ember ember--large"></span>
    <p class="finale__outcome overline"><%= game_session.outcome_victory? ? "Victory" : "Defeat" %></p>
    <h1><%= finale.title %></h1>
  </div>

  <p class="finale__closing"><%= finale.narration %></p>

  <hr>

  <div class="highlights">
    <div>
      <strong><%= duration_label(game_session.duration) %></strong>
      <span>Duration</span>
    </div>
    <div>
      <strong><%= game_session.rolls.count %></strong>
      <span>Dice rolled</span>
    </div>
  </div>
</div>

<div class="stage__footer">
  <%= link_to "New adventure", new_game_session_path, class: "btn btn--primary" %>
  <%= tag.button class: "btn btn--secondary",
        data: { controller: "share", action: "share#share", share_text_value: finale_share_text(game_session), share_copied_value: "Copied" } do %>
    <%= render "glyph", name: "share" %>
    <span data-share-target="label">Share summary</span>
  <% end %>
  <%= link_to "Back to home", root_path, class: "btn btn--ghost" %>
</div>
