<%# locals: (game_session:) -%>
<% finale = game_session.current_scene %>

<div class="finale">
  <div class="finale__crest">
    <span class="ember ember--large <%= "ember--pulsing" if finale.narrator_writing? %>"></span>
    <p class="finale__outcome overline"><%= t(game_session.outcome, scope: "game_session.outcomes") %></p>
    <h1><%= finale.title %></h1>
  </div>

  <%= tag.div id: "scene_narration", class: [ "finale__closing", "narration__body--writing": finale.narrator_writing? ] do %>
    <%= render "scenes/narration", scene: finale %>
  <% end %>

  <% if game_session.finished? %>
    <hr>

    <div class="highlights">
      <div>
        <strong><%= duration_label(game_session.duration) %></strong>
        <span><%= t(".duration") %></span>
      </div>
      <div>
        <strong><%= game_session.rolls.count %></strong>
        <span><%= t(".dice_rolled") %></span>
      </div>
    </div>
  <% end %>
</div>

<% if game_session.finished? %>
  <div class="stage__footer">
    <%= link_to t(".new_adventure"), new_game_session_path, class: "btn btn--primary" %>
    <%= tag.button class: "btn btn--secondary",
          data: { controller: "share", action: "share#share", share_text_value: finale_share_text(game_session), share_copied_value: t(".copied") } do %>
      <%= render "glyph", name: "share" %>
      <span data-share-target="label"><%= t(".share_summary") %></span>
    <% end %>
    <%= link_to t(".back_home"), root_path, class: "btn btn--ghost" %>
  </div>
<% else %>
  <%= render "game_sessions/waiting", scene: finale, text: t("scenes.scene.writing") %>
<% end %>
