<% content_for :title, "#{t(".title")} · Rokapi" %>

<%= render "back", to: root_path, title: t(".title") %>

<p class="lede"><%= t(".lede") %></p>

<div class="stack">
  <%= link_to new_game_sessions_solo_path, class: "pick pick--large" do %>
    <span class="pick__icon"><%= render "glyph", name: "person" %></span>
    <span class="pick__body">
      <span class="pick__title"><%= t(".solo") %></span>
      <span class="pick__text"><%= t(".solo_text") %></span>
    </span>
    <span class="pick__mark"></span>
  <% end %>

  <div class="pick pick--large pick--disabled">
    <span class="pick__icon"><%= render "glyph", name: "people" %></span>
    <span class="pick__body">
      <span class="pick__title"><%= t(".multiplayer") %></span>
      <span class="pick__text"><%= t(".multiplayer_text") %></span>
    </span>
    <span class="pick__mark"></span>
  </div>
</div>

<p class="hint"><%= t(".hint") %></p>
