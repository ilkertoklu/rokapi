<% content_for :title, "Hesabını oluştur · Rokapi" %>

<h1>Hesabını oluştur</h1>

<%= form_with url: signup_path do |form| %>
  <div>
    <%= form.label :email, "E-posta" %>
    <%= form.email_field :email, placeholder: "seninadresin@posta.com", required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <%= form.submit "Kod gönder", class: "btn btn--primary" %>
<% end %>

<p class="hint">Hesabın var mı? <%= link_to "Giriş yap", new_session_path %></p>
