<% content_for :title, "#{t(".title")} · Rokapi" %>
<% content_for :screen, "screen--medium" %>

<%= render "back", to: my_profile_path, title: t(".title") %>

<%= turbo_frame_tag :subscription, class: "plan-overview", target: "_top" do %>
  <%= render "subscription", subscription: @subscription %>
<% end %>

<% if hotwire_native_app? %>
  <%= purchasekit_paywall customer_id: Current.user.payment_processor.id, class: "restore" do |paywall| %>
    <%= paywall.restore t(".restore"), url: subscriptions_restoration_path, class: "btn btn--ghost" %>
  <% end %>
<% end %>
