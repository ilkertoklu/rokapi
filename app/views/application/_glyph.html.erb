<%# locals: (name:) -%>
<svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% case name %>
  <% when "back" %>
    <path d="M15 18l-6-6 6-6"></path>
  <% when "forward" %>
    <path d="m9 18 6-6-6-6"></path>
  <% when "heart" %>
    <path d="M12 21s-7-4.6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.4-7 10-7 10Z" fill="currentColor" stroke="none"></path>
  <% when "sword" %>
    <path d="M14.5 17.5 3 6V3h3l11.5 11.5"></path>
    <path d="m13 19 6-6"></path>
    <path d="m16 16 4 4"></path>
    <path d="m19 21 2-2"></path>
  <% when "person" %>
    <circle cx="12" cy="7" r="4"></circle>
    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
  <% when "share" %>
    <path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path>
    <path d="M16 6l-4-4-4 4"></path>
    <path d="M12 2v13"></path>
  <% when "flask" %>
    <path d="M9 3h6"></path>
    <path d="M10 3v5l-4 9a2 2 0 0 0 2 3h8a2 2 0 0 0 2-3l-4-9V3"></path>
  <% when "book" %>
    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
  <% when "pack" %>
    <path d="M6 8h12l1 12H5L6 8Z"></path>
    <path d="M9 8a3 3 0 0 1 6 0"></path>
  <% when "sliders" %>
    <path d="M4 21v-7"></path>
    <path d="M4 10V3"></path>
    <path d="M12 21v-9"></path>
    <path d="M12 8V3"></path>
    <path d="M20 21v-5"></path>
    <path d="M20 12V3"></path>
    <circle cx="4" cy="12" r="2"></circle>
    <circle cx="12" cy="10" r="2"></circle>
    <circle cx="20" cy="14" r="2"></circle>
  <% when "info" %>
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 16v-4M12 8h.01"></path>
  <% when "warning" %>
    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
    <path d="M12 9v4"></path>
    <path d="M12 17h.01"></path>
  <% when "cross" %>
    <path d="M18 6 6 18"></path>
    <path d="m6 6 12 12"></path>
  <% when "trash" %>
    <path d="M3 6h18"></path>
    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path>
    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
  <% when "wifi_off" %>
    <path d="M2 8.5A15 15 0 0 1 22 8.5"></path>
    <path d="M5 12.5a10 10 0 0 1 14 0"></path>
    <path d="M8.5 16a5 5 0 0 1 7 0"></path>
    <path d="m2 2 20 20"></path>
  <% when "check" %>
    <path d="M20 6 9 17l-5-5"></path>
  <% when "copy" %>
    <rect x="9" y="9" width="12" height="12" rx="2"></rect>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
  <% when "mail" %>
    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
  <% end %>
</svg>
