<%# locals: (name:) -%>
<svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <% case name %>
  <% when "back" %>
    <path d="M15 18l-6-6 6-6"></path>
  <% when "forward" %>
    <path d="m9 18 6-6-6-6"></path>
  <% when "heart" %>
    <path d="M12 21s-7-4.6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.4-7 10-7 10Z" fill="currentColor" stroke="none"></path>
  <% when "sword" %>
    <path d="M14.5 17.5 3 6V3h3l11.5 11.5"></path>
    <path d="m13 19 6-6"></path>
    <path d="m16 16 4 4"></path>
    <path d="m19 21 2-2"></path>
  <% when "person" %>
    <circle cx="12" cy="7" r="4"></circle>
    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
  <% when "share" %>
    <path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"></path>
    <path d="M16 6l-4-4-4 4"></path>
    <path d="M12 2v13"></path>
  <% when "flask" %>
    <path d="M9 3h6"></path>
    <path d="M10 3v5l-4 9a2 2 0 0 0 2 3h8a2 2 0 0 0 2-3l-4-9V3"></path>
  <% when "book" %>
    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
  <% when "pack" %>
    <path d="M6 8h12l1 12H5L6 8Z"></path>
    <path d="M9 8a3 3 0 0 1 6 0"></path>
  <% end %>
</svg>
