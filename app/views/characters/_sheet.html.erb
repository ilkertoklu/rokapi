<%# locals: (character:) -%>
<div id="character_sheet" class="sheet" data-sheet-target="sheet" hidden>
  <button class="sheet__scrim" data-action="sheet#close" aria-label="<%= t(".close") %>"></button>

  <div class="sheet__panel">
    <button class="sheet__handle" data-action="sheet#close" aria-label="<%= t(".close") %>"><span class="grip"></span></button>

    <header class="sheet__header">
      <span class="avatar"><%= character.user.initial %></span>
      <strong><%= character.user.name %></strong>
      <em><%= character.summary %></em>
    </header>

    <div class="vitals">
      <div class="vitals__row">
        <span class="vitals__label overline"><%= render "glyph", name: "heart" %> <%= t(".health") %></span>
        <span class="vitals__count"><%= character.hp %> <span>/ <%= character.max_hp %></span></span>
      </div>
      <div class="vitals__track">
        <div class="vitals__fill" style="inline-size: <%= character.hp_percentage %>%"></div>
      </div>
    </div>

    <% if character.status_effects.any? %>
      <p class="vitals__label overline"><%= t(".status_effects") %></p>
      <ul class="statuses">
        <% character.status_effects.each do |status| %>
          <li>
            <span class="statuses__dot <%= status.positive? ? "statuses__dot--positive" : "statuses__dot--negative" %>"></span>
            <span class="statuses__name"><%= status.name %></span>
            <span class="statuses__duration"><%= status.duration_label %></span>
            <span class="statuses__chip <%= status.positive? ? "statuses__chip--positive" : "statuses__chip--negative" %>"><%= t(".roll_modifier", modifier: format("%+d", status.modifier)) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if (items = character.items.carried).any? %>
      <p class="vitals__label overline"><%= t(".inventory") %></p>
      <ul class="inventory">
        <% items.each do |item| %>
          <li class="inventory__row inventory__row--<%= item.kind %>">
            <span class="inventory__icon"><%= render "glyph", name: item_glyph(item.kind) %></span>
            <span class="inventory__body">
              <span class="inventory__name"><%= item.name %></span>
              <% if item.instant? %>
                <span class="inventory__meta"><%= t(".instant", effect: format("%+d", item.hp_effect)) %></span>
              <% elsif item.description.present? %>
                <span class="inventory__meta"><%= item.description %></span>
              <% end %>
            </span>
            <% if item.quest? %>
              <span class="inventory__badge"><%= t(".quest_item") %></span>
            <% elsif item.usable? %>
              <span class="inventory__count">×<%= item.uses_left %></span>
              <%= button_to t(".use"), game_session_item_use_path(character.game_session, item), class: "inventory__use" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <p class="vitals__label overline"><%= t(".abilities") %></p>
    <dl class="sheet__stats">
      <% Character::Stat.all.each do |stat| %>
        <div>
          <dt><%= stat.label %></dt>
          <dd><%= character.stats[stat.key] %> <span><%= format("%+d", character.bonus_for(stat.key)) %></span></dd>
        </div>
      <% end %>
    </dl>

    <%= link_to t(".back_home"), root_path, class: "btn btn--ghost" %>
  </div>
</div>
