<%# locals: (character:) -%>
<dialog id="character_sheet" class="sheet" role="region" aria-labelledby="character_sheet_name"
        data-sheet-target="sheet" data-action="close->sheet#closed cancel->sheet#dismiss click->sheet#ignoreClickAfterDrag:capture turbo:before-morph-attribute->sheet#keepOpen:self">
  <button class="sheet__scrim" tabindex="-1" aria-hidden="true" data-sheet-target="scrim" data-action="sheet#close"></button>

  <div class="sheet__panel" data-sheet-target="panel"
       data-action="pointerdown->sheet#grab pointermove->sheet#drag pointerup->sheet#release pointercancel->sheet#release touchmove->sheet#holdPage:!passive">
    <button class="sheet__handle" autofocus data-sheet-target="handle" data-action="sheet#close" aria-label="<%= t(".close") %>"><span class="grip"></span></button>

    <header class="sheet__header">
      <%= avatar_tag character, hidden: true %>
      <strong id="character_sheet_name"><%= character.name %></strong>
      <em><%= character.summary %></em>
    </header>

    <div class="vitals">
      <div class="vitals__row">
        <span class="vitals__label"><%= render "glyph", name: "heart" %> <%= t(".health") %></span>
        <span class="vitals__count"><%= character.hp %> <span>/ <%= character.max_hp %></span></span>
      </div>
      <div class="vitals__track">
        <div class="vitals__fill" style="inline-size: <%= character.hp_percentage %>%"></div>
      </div>
    </div>

    <% if character.status_effects.any? %>
      <p class="vitals__label"><%= t(".status_effects") %></p>
      <ul class="statuses">
        <% character.status_effects.each do |status| %>
          <li>
            <%= tag.span class: [ "statuses__dot", status.positive? ? "statuses__dot--positive" : "statuses__dot--negative" ] %>
            <span class="statuses__name"><%= status.name %></span>
            <span class="statuses__duration"><%= status.duration_label %></span>
            <%= tag.span t(".roll_modifier", modifier: signed_number(status.modifier)),
                  class: [ "statuses__chip", status.positive? ? "statuses__chip--positive" : "statuses__chip--negative" ] %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if (items = character.items.carried).any? %>
      <p class="vitals__label"><%= t(".inventory") %></p>
      <ul class="inventory">
        <% items.each do |item| %>
          <%= tag.li class: [ "inventory__row", "inventory__row--#{item.kind}" ] do %>
            <span class="inventory__icon"><%= render "glyph", name: item_glyph(item.kind) %></span>
            <span class="inventory__body">
              <span class="inventory__name"><%= item.name %></span>
              <% if item.instant? %>
                <span class="inventory__meta"><%= t(".instant", effect: signed_number(item.hp_effect)) %></span>
              <% elsif item.description.present? %>
                <span class="inventory__meta"><%= item.passive? ? t(".passive", description: item.description) : item.description %></span>
              <% end %>
            </span>
            <% if item.quest? %>
              <span class="inventory__badge"><%= t(".quest_item") %></span>
            <% elsif item.usable? %>
              <span class="inventory__count">
                <span aria-hidden="true">×<%= item.uses_left %></span>
                <span class="visually-hidden"><%= t(".uses_left", count: item.uses_left) %></span>
              </span>
              <%= button_to t(".use"), game_session_item_use_path(character.game_session, item), class: "inventory__use" %>
            <% end %>
          <% end %>
        <% end %>
      </ul>
    <% end %>

    <p class="vitals__label"><%= t(".abilities") %></p>
    <dl class="sheet__stats">
      <% Character::Stat.all.each do |stat| %>
        <div>
          <dt><%= stat.label %></dt>
          <dd><%= character.stats[stat.key] %> <span><%= signed_number(character.bonus_for(stat.key)) %></span></dd>
        </div>
      <% end %>
    </dl>

    <%= link_to t(".back_home"), root_path, class: "btn btn--ghost" %>
  </div>
</dialog>
