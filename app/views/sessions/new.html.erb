<% content_for :title, "One-time code · Rokapi" %>

<div class="flow" data-controller="code" data-code-length-value="<%= LoginCode::CODE_LENGTH %>">
  <%= render "back", to: new_login_code_path, title: "One-time code" %>

  <p class="hint">
    We sent a one-time <%= LoginCode::CODE_LENGTH %>-digit code to
    <strong><%= session[:pending_email] %></strong>.
  </p>

  <%= form_with url: session_path, id: "code_form" do |form| %>
    <%= form.text_field :code, class: "code-input",
          inputmode: "numeric", pattern: "[0-9]*", maxlength: LoginCode::CODE_LENGTH,
          autocomplete: "one-time-code", required: true, autofocus: true,
          data: { code_target: "input", action: "input->code#update" } %>
  <% end %>

  <div class="sticky-footer stack">
    <%= submit_tag "Verify", form: "code_form", class: "btn btn--primary", data: { code_target: "submit" } %>

    <div data-controller="countdown">
      <%= button_to login_codes_resend_path, class: "resend", data: { countdown_target: "button" } do %>
        Resend code<span data-countdown-target="timer"></span>
      <% end %>
    </div>
  </div>
</div>
