<% content_for :title, "#{t(".title")} · Rokapi" %>

<%= tag.div class: "flow", data: { controller: "code", code_length_value: LoginCode::CODE_LENGTH, code_verify_value: t(".verify"),
      code_digits_left_value: t(".digits_left").to_json } do %>
  <%= render "back", to: new_login_code_path, title: t(".title") %>

  <p class="hint"><%= t(".sent_html", length: LoginCode::CODE_LENGTH, email: pending_email) %></p>

  <%= form_with url: session_path, class: "code-form" do |form| %>
    <div class="code">
      <%= form.text_field :code, class: "code__input",
            inputmode: "numeric", pattern: "[0-9]*", maxlength: LoginCode::CODE_LENGTH,
            autocomplete: "one-time-code", required: true, autofocus: true,
            data: { code_target: "input", action: "input->code#update" } %>
      <% LoginCode::CODE_LENGTH.times do %>
        <%= tag.span class: "code__cell", aria: { hidden: true }, data: { code_target: "cell" } %>
      <% end %>
    </div>

    <%= form.submit t(".verify"), class: "btn btn--primary", data: { code_target: "submit" } %>
  <% end %>

  <div data-controller="countdown">
    <%= button_to login_codes_resend_path, class: "resend", data: { countdown_target: "button" } do %>
      <%= t(".resend") %><span class="resend__timer" data-countdown-target="timer"></span>
    <% end %>
  </div>
<% end %>
