<% content_for :title, "Tek kullanımlık kod · Rokapi" %>

<h1>Tek kullanımlık kod</h1>

<p class="hint">
  Tek kullanımlık 6 haneli kodu <strong><%= session[:pending_email] %></strong>
  adresine gönderdik.
</p>

<%= form_with url: sessions_code_path do |form| %>
  <%= form.text_field :code, class: "code-input",
        inputmode: "numeric", pattern: "[0-9]*", maxlength: 6,
        autocomplete: "one-time-code", required: true, autofocus: true %>

  <%= form.submit "Doğrula", class: "btn btn--primary" %>
<% end %>

<div data-controller="countdown">
  <%= button_to sessions_resend_path, class: "btn btn--ghost", data: { countdown_target: "button" } do %>
    Kodu tekrar gönder<span data-countdown-target="timer"></span>
  <% end %>
</div>
