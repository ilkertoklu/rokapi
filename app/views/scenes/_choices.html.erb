<%# locals: (scene:) -%>
<details class="action-panel">
  <summary class="action-panel__handle">
    <span class="grip"></span>
    <span class="action-panel__prompt overline">Your turn</span>
  </summary>

  <div class="action-panel__body">
    <% scene.choices.each do |choice| %>
      <%= button_to game_session_choice_selection_path(scene.game_session, choice), class: "choice" do %>
        <span class="choice__label"><%= choice.label %></span>
        <span class="stat-chip"><%= Character::Stat.fetch(choice.stat).abbreviation %> <%= format("%+d", choice.modifier) %></span>
      <% end %>
    <% end %>

    <button class="character-button" data-action="sheet#open">
      <%= render "glyph", name: "person" %>
      <span>My character</span>
      <% if (ready = scene.active_player.character.items.usable.count).positive? %>
        <span class="character-button__hint"><%= pluralize(ready, "item") %> ready</span>
      <% end %>
    </button>
  </div>
</details>
