<%# locals: (scene:) -%>
<details class="action-panel" data-controller="action-panel" data-action-panel-open-from-value="64rem">
  <summary class="action-panel__handle">
    <span class="grip"></span>
    <span class="action-panel__prompt overline"><%= t(".your_turn") %></span>
  </summary>

  <div class="action-panel__body">
    <% scene.choices.each.with_index(1) do |choice, number| %>
      <%= button_to game_session_choice_selection_path(scene.game_session, choice), class: "choice",
            data: { controller: "hotkey", action: "keydown.#{number}@document->hotkey#click" } do %>
        <kbd class="choice__key"><%= number %></kbd>
        <span class="choice__label"><%= choice.label %></span>
        <span class="stat-chip"><%= Character::Stat.fetch(choice.stat).label %> <%= format("%+d", choice.modifier) %></span>
      <% end %>
    <% end %>

    <button class="character-button" data-action="sheet#open">
      <%= render "glyph", name: "person" %>
      <span><%= t(".my_character") %></span>
      <% if (ready = scene.active_player.character.items.usable.count).positive? %>
        <span class="character-button__hint"><%= t(".items_ready", count: ready) %></span>
      <% end %>
    </button>
  </div>
</details>
