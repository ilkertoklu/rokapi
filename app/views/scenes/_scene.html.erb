<%# locals: (scene:) -%>
<%= render "scenes/location", scene: scene %>

<div class="narration">
  <p class="scene__speaker overline"><span class="ember <%= "ember--pulsing" if scene.narrator_writing? %>"></span> Anlatıcı</p>
  <div id="scene_narration" class="narration__body"><%= scene.narration %></div>
</div>

<% if scene.choosing? %>
  <%= render "scenes/choices", scene: scene %>
<% elsif scene.stalled? %>
  <div class="stage__footer">
    <%= render "game_sessions/stalled", game_session: scene.game_session,
          hint: "Anlatıcı duraksadı. Hikâyeyi kaldığı yerden sürdürebilirsin." %>
  </div>
<% elsif scene.narrator_writing? %>
  <div class="stage__footer">
    <%= render "game_sessions/writing", text: "Anlatıcı sahneyi yazıyor" %>
    <% if scene.played? %>
      <div class="overdue">
        <%= render "game_sessions/stalled", game_session: scene.game_session,
              hint: "Anlatıcı gecikti. Hikâyeyi kaldığı yerden sürdürebilirsin." %>
      </div>
    <% end %>
  </div>
<% end %>
