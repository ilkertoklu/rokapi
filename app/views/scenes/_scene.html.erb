<%# locals: (scene:, viewer:) -%>
<% party = scene.game_session.multiplayer? %>
<%= render "scenes/location", scene: scene %>

<% if party && !scene.narrating? %>
  <%= render "scenes/party", scene: scene, viewer: viewer %>
<% end %>

<div class="narration">
  <%= render "scenes/narrator", scene: scene %>

  <% if party %>
    <%= render "scenes/feed", scene: scene %>
  <% end %>
</div>

<% if scene.turn_of?(viewer) %>
  <% if scene.choosing? %>
    <%= render "scenes/choices", scene: scene %>
  <% else %>
    <%= render "game_sessions/waiting", scene: scene, text: t(".writing") %>
  <% end %>
<% elsif scene.narrating? %>
  <div class="stage__footer">
    <%= render "game_sessions/writing", text: t(".writing") %>
  </div>
<% else %>
  <%= render "scenes/watch", scene: scene %>
<% end %>
