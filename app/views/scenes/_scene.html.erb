<%# locals: (scene:) -%>
<%= render "scenes/location", scene: scene %>

<div class="narration">
  <p class="scene__speaker overline"><span class="ember <%= "ember--pulsing" if scene.narrator_writing? %>"></span> Narrator</p>
  <%= tag.div id: "scene_narration", class: [ "narration__body", "narration__body--writing": scene.narrator_writing? ] do %>
    <%= render "scenes/narration", scene: scene %>
  <% end %>
</div>

<% if scene.choosing? %>
  <%= render "scenes/choices", scene: scene %>
<% else %>
  <%= render "game_sessions/waiting", scene: scene, text: "The narrator is writing the scene" %>
<% end %>
