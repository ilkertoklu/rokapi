<%# locals: (scene:) -%>
<header class="location">
  <div class="location__place">
    <h1><%= scene.title.presence || scene.game_session.title %></h1>
    <p><%= [ scene.location, scene.counter ].compact_blank.join(" · ") %></p>
  </div>

  <ol class="progress" aria-label="<%= scene.counter %>">
    <% (1..scene.game_session.scene_budget).each do |position| %>
      <li class="progress__dot progress__dot--<%= progress_at(scene, position) %>"></li>
    <% end %>
  </ol>
</header>
