<% content_for :title, "#{t(".title")} · Rokapi" %>

<%= form_with url: signup_profile_path, class: "flow" do |form| %>
  <h1><%= t(".title") %></h1>

  <div>
    <%= form.label :name, t(".name"), class: "field-label" %>
    <%= form.text_field :name, placeholder: t(".name"), required: true, autofocus: true, autocomplete: "given-name", maxlength: User::NAME_LENGTH %>
  </div>

  <div class="sticky-footer stack">
    <label class="terms">
      <%= form.check_box :terms, required: true %>
      <span><%= t(".terms_html") %></span>
    </label>

    <%= form.submit t(".submit"), class: "btn btn--primary" %>
  </div>
<% end %>
