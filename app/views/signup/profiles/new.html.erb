<% content_for :title, "Kaydını tamamla · Rokapi" %>

<%= form_with url: signup_profile_path, class: "flow" do |form| %>
  <h1>Kaydını tamamla</h1>

  <div>
    <%= form.label :name, "Adın" %>
    <%= form.text_field :name, placeholder: "Adın", required: true, autofocus: true, autocomplete: "given-name", maxlength: User::NAME_LENGTH %>
  </div>

  <label class="terms">
    <%= form.check_box :terms %>
    <span><a href="#">Kullanım Koşulları</a> ve <a href="#">Gizlilik Politikası</a>'nı kabul ediyorum.</span>
  </label>

  <div class="sticky-footer">
    <%= form.submit "Başla", class: "btn btn--primary" %>
  </div>
<% end %>
