<% content_for :title, "#{t(".title")} · Rokapi" %>

<div class="brand brand--hero">
  <span class="ember ember--large" aria-hidden="true"></span>

  <h1 class="greeting"><%= t(".greeting", name: Current.user.name) %></h1>
  <p><%= t(".ready") %></p>

  <div class="plan">
    <p class="plan__name overline"><%= t(".plan_name") %></p>
    <p class="plan__headline"><%= t(".plan_headline") %></p>
    <ul>
      <li><%= render "glyph", name: "check" %> <%= t(".perk_adventures") %></li>
      <li><%= render "glyph", name: "check" %> <%= t(".perk_own_sessions") %></li>
      <li><%= render "glyph", name: "check" %> <%= t(".perk_joining") %></li>
    </ul>
  </div>
</div>

<div class="stack">
  <%= link_to t(".continue"), root_path, class: "btn btn--primary" %>
</div>
