<% content_for :title, "Hoş geldin · Rokapi" %>

<div class="brand brand--hero">
  <span class="ember ember--large" aria-hidden="true"></span>

  <h1 class="greeting">Hoş geldin, <%= Current.user.name %></h1>
  <p>Hesabın hazır. İlk maceraların bizden.</p>

  <div class="plan">
    <p class="plan__name overline">Ücretsiz plan</p>
    <p class="plan__headline">%100 kullanım</p>
    <ul>
      <li>Her ay ≈ 1-2 kısa macera</li>
      <li>Yalnızca senin başlattığın oturumlarda azalır</li>
      <li>Kodla bir odaya katılmak zaten hep ücretsiz</li>
    </ul>
  </div>
</div>

<div class="stack">
  <%= link_to "Devam et", root_path, class: "btn btn--primary" %>
</div>
