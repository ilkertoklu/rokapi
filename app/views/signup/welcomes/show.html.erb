<% content_for :title, "Welcome · Rokapi" %>

<div class="brand brand--hero">
  <span class="ember ember--large" aria-hidden="true"></span>

  <h1 class="greeting">Welcome, <%= Current.user.name %></h1>
  <p>Your account is ready. Your first adventures are on us.</p>

  <div class="plan">
    <p class="plan__name overline">Free plan</p>
    <p class="plan__headline">100% left</p>
    <ul>
      <li>About 1-2 short adventures a month</li>
      <li>Only the sessions you start count against it</li>
      <li>Joining a room with a code is always free</li>
    </ul>
  </div>
</div>

<div class="stack">
  <%= link_to "Continue", root_path, class: "btn btn--primary" %>
</div>
