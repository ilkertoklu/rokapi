<%# locals: (roll:) -%>
<%= tag.div class: [ "d20", "d20--settled": roll&.resolved? ] do %>
  <div class="d20__face">
    <span class="d20__die">d20</span>

    <% if roll.nil? || roll.stalled? %>
      <span class="d20__value">?</span>
    <% elsif roll.resolved? %>
      <span class="d20__value"><%= roll.value %></span>
    <% else %>
      <% faces = die_reel_faces(roll) %>
      <span class="visually-hidden"><%= t(".rolling") %></span>
      <span class="d20__reel" aria-hidden="true">
        <span class="d20__strip" style="--cells: <%= faces.size %>">
          <% faces.each do |face| %><span><%= face %></span><% end %>
        </span>
      </span>
    <% end %>
  </div>
<% end %>
