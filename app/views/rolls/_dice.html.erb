<%# locals: (choice:, roll:, game_session:) -%>
<div class="dice">
  <p class="dice__prompt"><%= choice.label %></p>

  <%= render "rolls/die", roll: roll %>

  <dl class="dice__facts">
    <div>
      <dt class="overline">Difficulty <span>· narrator</span></dt>
      <dd>
        <%= choice.difficulty.capitalize %>
        <span class="target">Target <%= choice.target %></span>
      </dd>
    </div>
    <div>
      <dt class="overline">Bonus</dt>
      <dd>
        <%= Character::Stat.fetch(choice.stat).label %> <%= choice.stat_value %>
        <span class="arrow">→</span>
        <span class="modifier"><%= format("%+d", choice.modifier) %></span>
      </dd>
    </div>
  </dl>

  <% if choice.difficulty_reason.present? %>
    <p class="dice__reason"><%= choice.difficulty_reason %></p>
  <% end %>
</div>

<div class="stage__footer">
  <% if roll.nil? %>
    <%= button_to "Roll the die", game_session_roll_path(game_session), class: "btn btn--primary" %>
  <% elsif roll.stalled? %>
    <%= render "game_sessions/stalled", game_session: game_session,
          hint: "The narrator stalled. Your roll has not been resolved yet." %>
  <% else %>
    <%= render "game_sessions/writing", text: "The narrator is resolving the roll" %>
  <% end %>
</div>
