<%# locals: (choice:, roll:, character:, game_session:) -%>
<div class="dice">
  <h1 class="dice__prompt"><%= choice.label %></h1>

  <%= render "rolls/die", roll: roll %>

  <dl class="dice__facts">
    <div>
      <dt><%= t(".difficulty") %> <span><%= t(".difficulty_source") %></span></dt>
      <dd>
        <%= choice.difficulty_label %>
        <span class="dice__target"><%= t(".target", target: choice.target) %></span>
      </dd>
    </div>
    <div>
      <dt><%= t(".bonus") %></dt>
      <dd class="dice__bonus">
        <%= choice.stat_label %> <%= choice.stat_value %>
        <span class="dice__arrow" aria-hidden="true">→</span>
        <span class="dice__modifier"><%= signed_number(choice.modifier) %></span>
      </dd>
    </div>
    <% character.status_effects.each do |status| %>
      <div>
        <dt><%= t(".status") %></dt>
        <dd class="dice__bonus">
          <%= status.name %>
          <span class="dice__arrow" aria-hidden="true">→</span>
          <%= tag.span signed_number(status.modifier), class: [ "dice__modifier", "dice__modifier--negative": status.modifier.negative? ] %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>

<div class="stage__footer">
  <% if roll.nil? %>
    <%= button_to game_session_roll_path(game_session), class: "btn btn--primary",
          aria: { keyshortcuts: "Enter" }, data: { controller: "hotkey", action: "keydown.enter@document->hotkey#click" } do %>
      <%= t(".roll") %> <kbd class="key" aria-hidden="true">↵</kbd>
    <% end %>
  <% elsif roll.stalled? %>
    <%= render "game_sessions/stalled", game_session: game_session,
          hint: t(".stalled") %>
  <% else %>
    <%= render "game_sessions/writing", text: t(".resolving") %>
  <% end %>
</div>
