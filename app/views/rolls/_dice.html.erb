<%# locals: (choice:, roll:, game_session:) -%>
<div class="dice">
  <p class="dice__prompt"><%= choice.label %></p>

  <%= render "rolls/die", roll: roll %>

  <dl class="dice__facts">
    <div>
      <dt class="overline"><%= t(".difficulty") %> <span><%= t(".difficulty_source") %></span></dt>
      <dd>
        <%= choice.difficulty_label %>
        <span class="target"><%= t(".target", target: choice.target) %></span>
      </dd>
    </div>
    <div>
      <dt class="overline"><%= t(".bonus") %></dt>
      <dd class="dice__bonus">
        <%= Character::Stat.fetch(choice.stat).label %> <%= choice.stat_value %>
        <span class="arrow">→</span>
        <span class="modifier"><%= format("%+d", choice.modifier) %></span>
      </dd>
    </div>
  </dl>

  <% if choice.difficulty_reason.present? %>
    <p class="dice__reason"><%= choice.difficulty_reason %></p>
  <% end %>
</div>

<div class="stage__footer">
  <% if roll.nil? %>
    <%= button_to t(".roll"), game_session_roll_path(game_session), class: "btn btn--primary" %>
  <% elsif roll.stalled? %>
    <%= render "game_sessions/stalled", game_session: game_session,
          hint: t(".stalled") %>
  <% else %>
    <%= render "game_sessions/writing", text: t(".resolving") %>
  <% end %>
</div>
