<%# locals: (roll:, game_session:) -%>
<div class="outcome outcome--<%= roll.success? ? "success" : "failure" %>">
  <%= render "rolls/die", roll: roll %>

  <p class="outcome__math">
    <%= roll.value %> <span><%= signed_number(roll.modifier) %> <%= lowercase(roll.choice.stat_label) %></span>
    <% if roll.status_modifier.nonzero? %><span><%= signed_number(roll.status_modifier) %> <%= t(".statuses") %></span><% end %>
    = <strong><%= roll.total %></strong> · <%= t(".target", target: roll.target) %> · <%= roll.choice.difficulty_label %>
  </p>

  <p class="outcome__verdict"><%= outcome_verdict(roll) %></p>

  <%= simple_format roll.resolution, class: "outcome__resolution" %>

  <% if roll.hp_change.nonzero? %>
    <p class="outcome__effect"><%= render "glyph", name: "heart" %> <%= t(".health_change", change: signed_number(roll.hp_change)) %></p>
  <% end %>

  <% roll.items_gained.each do |gain| %>
    <p class="outcome__gain">
      <span class="outcome__gain-icon"><%= render "glyph", name: item_glyph(gain["kind"]) %></span>
      <span class="outcome__gain-label overline"><%= t(".added_to_inventory") %></span>
      <span class="outcome__gain-name"><%= gain["name"] %></span>
    </p>
  <% end %>

  <% roll.statuses_gained.each do |status| %>
    <%= tag.p class: [ "outcome__gain", "outcome__gain--negative": status["modifier"].negative? ] do %>
      <span class="outcome__gain-label overline"><%= t(".status") %></span>
      <span class="outcome__gain-name"><%= status["name"] %></span>
    <% end %>
  <% end %>
</div>

<div class="stage__footer">
  <%= button_to game_session_acknowledgement_path(game_session), class: "btn btn--primary",
        aria: { keyshortcuts: "Enter" }, data: { controller: "hotkey", action: "keydown.enter@document->hotkey#click" } do %>
    <%= t(".continue") %> <kbd class="key" aria-hidden="true">↵</kbd>
  <% end %>
</div>
