<%# locals: (roll:, game_session:) -%>
<div class="outcome outcome--<%= roll.success? ? "success" : "failure" %>">
  <%= render "rolls/die", roll: roll %>

  <p class="outcome__math">
    <%= roll.value %> <span><%= format("%+d", roll.modifier) %> <%= Character::Stat.fetch(roll.choice.stat).label.downcase %></span>
    = <strong><%= roll.total %></strong> · target <%= roll.target %> · <%= roll.choice.difficulty.capitalize %>
  </p>

  <p class="outcome__verdict"><%= outcome_verdict(roll) %></p>

  <p class="outcome__resolution"><%= roll.resolution %></p>

  <% if roll.hp_change.nonzero? %>
    <p class="outcome__effect"><%= format("%+d", roll.hp_change) %> Health</p>
  <% end %>

  <% roll.items_gained.each do |gain| %>
    <p class="outcome__gain">
      <span class="outcome__gain-icon"><%= render "glyph", name: item_glyph(gain["kind"]) %></span>
      <span class="outcome__gain-label overline">Added to inventory</span>
      <span class="outcome__gain-name"><%= gain["name"] %></span>
    </p>
  <% end %>

  <% roll.statuses_gained.each do |status| %>
    <p class="outcome__gain">
      <span class="outcome__gain-label overline">Status</span>
      <span class="outcome__gain-name"><%= status["name"] %></span>
    </p>
  <% end %>
</div>

<div class="stage__footer">
  <%= button_to "Continue", game_session_acknowledgement_path(game_session), class: "btn btn--primary" %>
</div>
