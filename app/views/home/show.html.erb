<div class="profile">
  <%= render "profile_badge" %>
</div>

<%= render "brand" %>

<div class="stack">
  <% if @resumable_game_session %>
    <%= link_to game_session_path(@resumable_game_session), class: "resume" do %>
      <span class="resume__body">
        <span class="resume__title"><%= t(".resume") %></span>
        <span class="resume__text"><%= resume_summary(@resumable_game_session) %></span>
      </span>
      <span class="resume__chevron"><%= render "glyph", name: "forward" %></span>
    <% end %>
  <% end %>

  <%= link_to t(".start"), new_game_session_path, class: "btn btn--primary" %>
  <%= link_to t(".join"), new_game_sessions_join_path, class: "btn btn--secondary" %>
</div>
