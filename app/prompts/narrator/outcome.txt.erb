<% character = roll.player.character %><% used = character.items.used_since(roll.scene.created_at) %><%= roll.player.name %> chose "<%= roll.choice.label %>": die <%= roll.value %>, modifier <%= format("%+d", roll.modifier) %>, statuses <%= format("%+d", roll.status_modifier) %>, total <%= roll.total %> against <%= roll.target %>. <%= roll.grade_label %>, margin <%= format("%+d", roll.margin) %>.
<% if used.any? %>Used since the scene began, already applied: <%= used.map { |item| "#{item.name} (#{format("%+d", item.hp_effect)} health)" }.join(", ") %>.
<% end %><%= roll.player.name %> now: <%= character.sheet %>.
